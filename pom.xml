<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ca.bazlur</groupId>
    <artifactId>virtual-thread-simulation</artifactId>
    <version>1.0.0</version>
    <name>Virtual Thread Machine</name>
    <url>https://github.com/rokon12/virtual-thread-simulation</url>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>25.0.1</javafx.version>
        <junit.version>5.11.4</junit.version>
        <app.display.name>Virtual Thread Machine</app.display.name>
        <app.menu.name>VT Machine</app.menu.name>
        <app.package.name>virtual-thread-machine</app.package.name>
        <app.identifier>ca.bazlur.virtualthreadmachine</app.identifier>
        <app.version>${project.version}</app.version>
        <app.vendor>Bazlur Rahman</app.vendor>
        <app.description>An interactive JavaFX visualization of Java virtual threads.</app.description>
        <app.copyright>Copyright (c) 2026 Bazlur Rahman</app.copyright>
        <jpackage.platform.options></jpackage.platform.options>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>vtmachine/vtmachine.App</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native-image</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copy-runtime-modules</id>
                                <phase>prepare-package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${project.build.directory}/jpackage-modules</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>jpackage-app-image</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/dist/${app.display.name}.app" quiet="true" />
                                        <delete dir="${project.build.directory}/dist/${app.display.name}" quiet="true" />
                                        <mkdir dir="${project.build.directory}/dist" />
                                        <exec executable="${java.home}/bin/jpackage" failonerror="true">
                                            <arg value="--type"/><arg value="app-image"/>
                                            <arg value="--name"/><arg value="${app.display.name}"/>
                                            <arg value="--dest"/><arg value="${project.build.directory}/dist"/>
                                            <arg value="--app-version"/><arg value="${app.version}"/>
                                            <arg value="--vendor"/><arg value="${app.vendor}"/>
                                            <arg value="--description"/><arg value="${app.description}"/>
                                            <arg value="--copyright"/><arg value="${app.copyright}"/>
                                            <arg value="--module-path"/>
                                            <arg value="${project.build.outputDirectory}${path.separator}${project.build.directory}/jpackage-modules"/>
                                            <arg value="--module"/><arg value="vtmachine/vtmachine.App"/>
                                            <arg value="--java-options"/><arg value="--enable-native-access=javafx.graphics"/>
                                            <arg line="${jpackage.platform.options}"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>jpackage-macos</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <jpackage.platform.options>--mac-package-identifier ${app.identifier} --mac-package-name "${app.menu.name}" --mac-app-category education</jpackage.platform.options>
            </properties>
        </profile>
    </profiles>

</project>
